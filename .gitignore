# ==========================================
# Cafena Project - Root .gitignore
# ==========================================

# Dependencies (Backend & Frontend)
node_modules/
.pnp
.pnp.js
.pnpm-store/

# Production build outputs & compiled assets
dist/
dist-ssr/
build/
out/
.output/
*.tsbuildinfo

# Environment variables & credentials
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Logs & debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing & Test Coverage
coverage/
.nyc_output/
*.lcov
vitest-report/
.coverage/

# Database local storage & generated files
*.sqlite
*.sqlite3
*.sqlite-journal
*.db
/Backend/src/generated/prisma
postgres-data/
postgres_data/

# Cache & Temporary files
.cache/
.parcel-cache/
.eslintcache
.prettiercache
.oxlintcache
*.tmp
*.temp
tmp/
temp/
scratch/

# IDE & Code Editor files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Docker local override
docker-compose.override.yml
