{
  "info": {
    "_postman_id": "cafena-category-collection-v1",
    "name": "Cafena Coffee - 4. Category Management",
    "description": "Bộ sưu tập kiểm thử toàn diện Chức năng 4: Quản lý danh mục (Danh sách, Phân trang, Tìm kiếm, Cây phân cấp Cha-Con, Chi tiết ID/Slug, Sản phẩm theo danh mục, Ẩn/Hiện danh mục, CRUD và Chặn xóa an toàn).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api/v1",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "categoryId",
      "value": "",
      "type": "string"
    },
    {
      "key": "categorySlug",
      "value": "ca-phe-arabica",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Đăng nhập Admin lấy Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    const res = pm.response.json();",
              "    if (res.data && res.data.accessToken) {",
              "        pm.collectionVariables.set('adminToken', res.data.accessToken);",
              "        console.log('Đã lưu adminToken vào biến Collection!');",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@cafena.vn\",\n  \"password\": \"admin123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "1. Danh sách danh mục có phân trang (Get Categories)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/categories?page=1&limit=10",
          "host": ["{{baseUrl}}"],
          "path": ["categories"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" }
          ]
        }
      }
    },
    {
      "name": "2. Tìm kiếm danh mục theo từ khóa (Search Category)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/categories?search=Arabica",
          "host": ["{{baseUrl}}"],
          "path": ["categories"],
          "query": [
            { "key": "search", "value": "Arabica" }
          ]
        }
      }
    },
    {
      "name": "3. Lấy cấu trúc cây danh mục đa cấp (Category Tree)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/categories/tree",
          "host": ["{{baseUrl}}"],
          "path": ["categories", "tree"]
        },
        "description": "Trả về cây đa cấp Cha -> Con lồng nhau phục vụ Menu thanh điều hướng (Navbar)."
      }
    },
    {
      "name": "4. Chi tiết danh mục theo Slug SEO",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/categories/{{categorySlug}}",
          "host": ["{{baseUrl}}"],
          "path": ["categories", "{{categorySlug}}"]
        }
      }
    },
    {
      "name": "5. Lấy danh sách sản phẩm theo danh mục (Get Products by Category)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/categories/{{categorySlug}}/products?page=1&limit=10&includeChildren=true",
          "host": ["{{baseUrl}}"],
          "path": ["categories", "{{categorySlug}}", "products"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" },
            { "key": "includeChildren", "value": "true" }
          ]
        },
        "description": "Lấy sản phẩm của danh mục, tự động gom cả sản phẩm trong các danh mục con trực thuộc."
      }
    },
    {
      "name": "6. Tạo danh mục cha mới (Create Parent Category - Admin)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "    const res = pm.response.json();",
              "    if (res.data && res.data.id) {",
              "        pm.collectionVariables.set('categoryId', res.data.id);",
              "        pm.collectionVariables.set('categorySlug', res.data.slug);",
              "        console.log('Đã lưu categoryId & categorySlug mới!');",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Dụng Cụ Pha Chế Chuyên Nghiệp\",\n  \"description\": \"Các loại phin inox, bình syphon, ấm rót cổ ngỗng và phễu lọc V60\",\n  \"isActive\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/categories",
          "host": ["{{baseUrl}}"],
          "path": ["categories"]
        }
      }
    },
    {
      "name": "7. Tạo danh mục con lồng nhau (Create Sub-Category - Admin)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Phin Pha Cà Phê Truyền Thống\",\n  \"parentId\": \"{{categoryId}}\",\n  \"description\": \"Phin nhôm mạ anot và phin inox chất lượng cao\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/categories",
          "host": ["{{baseUrl}}"],
          "path": ["categories"]
        }
      }
    },
    {
      "name": "8. Cập nhật danh mục (Update Category - Admin)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Mô tả đã được cập nhật mới nhất cho danh mục\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/categories/{{categoryId}}",
          "host": ["{{baseUrl}}"],
          "path": ["categories", "{{categoryId}}"]
        }
      }
    },
    {
      "name": "9. Ẩn hoặc Hiển thị danh mục (Toggle Active Status - Admin)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/categories/{{categoryId}}/status?isActive=false",
          "host": ["{{baseUrl}}"],
          "path": ["categories", "{{categoryId}}", "status"],
          "query": [
            { "key": "isActive", "value": "false" }
          ]
        }
      }
    },
    {
      "name": "10. Xóa danh mục an toàn (Delete Category - Admin)",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/categories/{{categoryId}}",
          "host": ["{{baseUrl}}"],
          "path": ["categories", "{{categoryId}}"]
        },
        "description": "Chặn xóa nếu danh mục đang chứa sản phẩm hoặc có danh mục con trực thuộc (400 Bad Request)."
      }
    }
  ]
}
