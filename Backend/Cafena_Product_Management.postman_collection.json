{
  "info": {
    "_postman_id": "cafena-product-collection-v1",
    "name": "Cafena Coffee - 3. Product Management & Display",
    "description": "Bộ sưu tập kiểm thử toàn diện Chức năng 3: Quản lý và hiển thị sản phẩm (Danh sách, Phân trang, Tìm kiếm, Lọc đa tiêu chí, Sắp xếp, Bộ sưu tập, Chi tiết theo ID/Slug, Sản phẩm liên quan, Tồn kho, CRUD, Import/Export, Batch actions).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api/v1",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "CF-0001",
      "type": "string"
    },
    {
      "key": "productSlug",
      "value": "arabica-cau-dat-thuong-hang",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Đăng nhập Admin lấy Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    const res = pm.response.json();",
              "    if (res.data && res.data.accessToken) {",
              "        pm.collectionVariables.set('adminToken', res.data.accessToken);",
              "        console.log('Đã lưu adminToken vào biến Collection!');",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@cafena.vn\",\n  \"password\": \"admin123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "1. Danh sách sản phẩm có phân trang (Pagination)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products?page=1&limit=10",
          "host": ["{{baseUrl}}"],
          "path": ["products"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" }
          ]
        }
      }
    },
    {
      "name": "2. Tìm kiếm theo tên, mã, mô tả (Search)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products?search=Robusta",
          "host": ["{{baseUrl}}"],
          "path": ["products"],
          "query": [
            { "key": "search", "value": "Robusta" }
          ]
        }
      }
    },
    {
      "name": "3. Lọc theo Loại sản phẩm & Khoảng giá & Còn hàng (Filters)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products?productType=Hạt rang mộc&minPrice=100000&maxPrice=150000&inStockOnly=true",
          "host": ["{{baseUrl}}"],
          "path": ["products"],
          "query": [
            { "key": "productType", "value": "Hạt rang mộc" },
            { "key": "minPrice", "value": "100000" },
            { "key": "maxPrice", "value": "150000" },
            { "key": "inStockOnly", "value": "true" }
          ]
        }
      }
    },
    {
      "name": "4. Sắp xếp giá tăng dần (Sort price_asc)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products?sortBy=price_asc",
          "host": ["{{baseUrl}}"],
          "path": ["products"],
          "query": [
            { "key": "sortBy", "value": "price_asc" }
          ]
        }
      }
    },
    {
      "name": "5. Sản phẩm mới nhất (New Arrivals)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/collection/newest?limit=8",
          "host": ["{{baseUrl}}"],
          "path": ["products", "collection", "newest"],
          "query": [
            { "key": "limit", "value": "8" }
          ]
        }
      }
    },
    {
      "name": "6. Sản phẩm nổi bật (Featured Products)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/collection/featured?limit=8",
          "host": ["{{baseUrl}}"],
          "path": ["products", "collection", "featured"],
          "query": [
            { "key": "limit", "value": "8" }
          ]
        }
      }
    },
    {
      "name": "7. Sản phẩm bán chạy (Best Sellers)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/collection/best-sellers?limit=8",
          "host": ["{{baseUrl}}"],
          "path": ["products", "collection", "best-sellers"],
          "query": [
            { "key": "limit", "value": "8" }
          ]
        }
      }
    },
    {
      "name": "8. Chi tiết sản phẩm theo ProductID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["products", "{{productId}}"]
        }
      }
    },
    {
      "name": "9. Chi tiết sản phẩm theo Slug SEO",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/{{productSlug}}",
          "host": ["{{baseUrl}}"],
          "path": ["products", "{{productSlug}}"]
        }
      }
    },
    {
      "name": "10. Sản phẩm liên quan (Related Products)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/{{productId}}/related?limit=4",
          "host": ["{{baseUrl}}"],
          "path": ["products", "{{productId}}", "related"],
          "query": [
            { "key": "limit", "value": "4" }
          ]
        }
      }
    },
    {
      "name": "11. Kiểm tra tình trạng kinh doanh & tồn kho (Stock Status)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/{{productId}}/stock-status",
          "host": ["{{baseUrl}}"],
          "path": ["products", "{{productId}}", "stock-status"]
        }
      }
    },
    {
      "name": "12. Thêm mới sản phẩm (Create Product - Admin/Staff)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ProductName\": \"Cà Phê Moka Cầu Đất Độc Bản\",\n  \"ProductType\": \"Hạt rang mộc\",\n  \"Price\": 220000,\n  \"Quantity\": 50,\n  \"Unit\": \"gói 250g\",\n  \"Description\": \"Nữ hoàng cà phê Moka Cầu Đất quý hiếm, hương thơm nồng nàn quý phái.\",\n  \"roastLevel\": \"Medium\",\n  \"flavorNotes\": \"Hương hoa nhài, Cam ngọt, Socola\",\n  \"origin\": \"Cầu Đất, Đà Lạt\",\n  \"isFeatured\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": ["{{baseUrl}}"],
          "path": ["products"]
        }
      }
    },
    {
      "name": "13. Cập nhật sản phẩm (Update Product - Admin/Staff)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"Price\": 150000,\n  \"Quantity\": 180\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/products/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["products", "{{productId}}"]
        }
      }
    },
    {
      "name": "14. Nhân bản 1 sản phẩm (Duplicate Product - Admin/Staff)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/products/{{productId}}/duplicate",
          "host": ["{{baseUrl}}"],
          "path": ["products", "{{productId}}", "duplicate"]
        }
      }
    },
    {
      "name": "15. Xuất Excel danh sách sản phẩm (Export Excel)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/export/excel",
          "host": ["{{baseUrl}}"],
          "path": ["products", "export", "excel"]
        }
      }
    }
  ]
}
